# Used in the browser and on the server if API_BASE_URL is unset.
# Example: https://api.example.com  or  http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=

# Optional: server-only base URL (e.g. Docker service name, internal LB).
# Falls back to NEXT_PUBLIC_API_BASE_URL when empty.
API_BASE_URL=

# Optional proxy (see next.config.mjs): set NEXT_PUBLIC_API_BASE_URL=/api-backend
API_PROXY_TARGET=
